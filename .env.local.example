NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Google Places API (New) key — server-side only. Used by /api/google-reviews
# to fetch Google reviews for the stores. Create in Google Cloud Console →
# APIs & Services → enable "Places API (New)" → create + restrict an API key.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Optional: Firebase Admin SDK service account (server-side Firestore writes).
# Needed by /api/admin/sync-auth and the Google-reviews Firestore cache.
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
