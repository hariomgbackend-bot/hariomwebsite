/* ════════════════════════════════════════════════════════════════
   FIRESTORE SECURITY RULES — Hariom Electronics
   ════════════════════════════════════════════════════════════════
   Paste the entire content below into your Firebase Console →
     Firestore Database → Rules
   ════════════════════════════════════════════════════════════════
   REPLACE 'ADMIN_UID_HERE' with your actual admin user UID.
   You can get your UID from Firebase Console → Authentication → Users
   ════════════════════════════════════════════════════════════════ */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if the requester is our verified admin ──
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'OIkdwBtfJTgy1ZQpkKiH0YxdIgo2';
    }

    // ── PRODUCTS: public read, admin write/delete ──
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── PROMOTIONS: public read, admin write/delete ──
    match /promotions/{promotionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── ENQUIRIES: public create (form submission),
    //               admin read/update/delete ──
    match /enquiries/{enquiryId} {
      allow create: if request.auth == null
                    || request.auth.uid != null;   // allow anyone to submit
      allow read, update, delete: if isAdmin();
    }

    // ── ORDERS: customer checkout + admin management ──
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── CUSTOMER PROFILES: customers manage their own saved checkout info ──
    match /customer_profiles/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── RETURNS: customers submit/read their own requests, admin manages all ──
    match /returns/{returnId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Deny everything else by default ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
