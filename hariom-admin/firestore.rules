rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'OIkdwBtfJTgy1ZQpkKiH0YxdIgo2';
    }

    // PRODUCTS: public read, admin write/delete
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // CATEGORIES: public read, admin write/delete
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // BRANDS: public read, admin write/delete
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // PROMOTIONS: public read, admin write/delete
    match /promotions/{promotionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // TALLY PRODUCTS: admin read/write (Tally sync index)
    match /tally_products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ENQUIRIES: anyone can submit, admin manages
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ORDERS: guest + logged-in customers can create, admin manages all
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // CUSTOMER PROFILES: customers manage their own data
    match /customer_profiles/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if isAdmin();
    }

    // RETURNS: customers submit their own, admin manages all
    match /returns/{returnId} {
      allow create: if true;
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // SITE SECTIONS: public read, admin write
    match /site_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
